# AI 项目分析所需的环境变量（复制为 .env.local 后填写，重启 dev server 生效）
# 优先级：环境变量 > 设置页面持久化值 > 默认值（环境变量存在时以环境变量为准）

# 必填：你的模型服务 API Key（未配置时，可在设置页面填写）
OPENAI_API_KEY=

# 可选：OpenAI 兼容接口的 base URL（默认 https://api.openai.com/v1）
# - DeepSeek:  https://api.deepseek.com/v1
# - 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# - Moonshot:  https://api.moonshot.cn/v1
# - 本地 Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：模型名称（默认 gpt-4o-mini），所有 AI 分析统一使用该模型
AI_MODEL=gpt-4o-mini

# 可选：GitHub Personal Access Token，用于提升 GitHub API 速率限制（60 → 5000 次/小时）
GITHUB_TOKEN=

# 可选：函数全景图最大下钻层数（默认 2，范围 1–20）
MAX_DRILLDOWN_DEPTH=2

# 可选：子函数识别时返回的关键子函数数量上限（默认 10，范围 1–20）
SUBFUNCTION_COUNT=10
